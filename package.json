{
  "name": "pr-doc-engine",
  "version": "1.0.0",
  "description": "Reusable GitHub Action that validates PR documentation and optionally archives it.",
  "main": "dist/index.js",
  "bin": {
    "pr-doc-engine": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/index.ts -o dist/action --license licenses.txt",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "googleapis": "^133.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
